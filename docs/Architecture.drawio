        <mxCell id="ZYIOzBKSQIWWelf5VHZs-147" value="&lt;div&gt;&lt;b&gt;Requirements:&lt;/b&gt;&lt;/div&gt;&lt;b&gt;Document Storage (Ingestion Phase)&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Actor can store Documents&lt;/span&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;The system allows the Actor to upload and store documents (e.g., resumes, PDFs, unstructured text). During ingestion, the app:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;Extracts text from PDFs&lt;/li&gt;&lt;li&gt;Cleans and normalizes the content&lt;/li&gt;&lt;li&gt;Splits the text into semantically meaningful chunks&lt;/li&gt;&lt;li&gt;Generates embeddings using the configured embedding model&lt;/li&gt;&lt;li&gt;Stores chunks, embeddings, and metadata in the database&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;div&gt;&lt;b&gt;Outcome&lt;/b&gt;:&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;Documents become &lt;strong&gt;searchable&lt;/strong&gt;, &lt;strong&gt;vectorized&lt;/strong&gt;, and &lt;strong&gt;ready for retrieval&lt;/strong&gt;.&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="1138.25" y="-2265" width="328.5" height="300" as="geometry" />
        </mxCell>
        <mxCell id="ZYIOzBKSQIWWelf5VHZs-151" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" parent="1" source="ZYIOzBKSQIWWelf5VHZs-150" target="ZYIOzBKSQIWWelf5VHZs-139" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ZYIOzBKSQIWWelf5VHZs-152" value="defines" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" parent="ZYIOzBKSQIWWelf5VHZs-151" vertex="1" connectable="0">
          <mxGeometry x="-0.4125" relative="1" as="geometry">
            <mxPoint y="3" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ZYIOzBKSQIWWelf5VHZs-150" value="&lt;div&gt;&lt;div&gt;&lt;b&gt;Requirements:&lt;/b&gt;&lt;/div&gt;&lt;b&gt;&lt;/b&gt;&lt;/div&gt;&lt;b&gt;Document Search (Retrieval Phase)&lt;/b&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Actor can search Documents and gets best results.&lt;/span&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;The system enables the Actor to perform semantic search over all stored documents. When a query is submitted, the app:&lt;/li&gt;&lt;ul&gt;&lt;li&gt;&lt;/li&gt;&lt;li&gt;Expands and normalizes the query&lt;/li&gt;&lt;li&gt;Generates an embedding for the query&lt;/li&gt;&lt;li&gt;Performs vector similarity search (cosine distance)&lt;/li&gt;&lt;li&gt;Retrieves the most relevant document chunks&lt;/li&gt;&lt;li&gt;Returns ranked results with distances and metadata&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;div&gt;&lt;b&gt;Outcome&lt;/b&gt;:&lt;/div&gt;&lt;/div&gt;&lt;div&gt;The Actor receives &lt;strong&gt;high‑precision&lt;/strong&gt;, &lt;strong&gt;context‑aware&lt;/strong&gt; matches based on skills, experience, responsibilities, and other resume‑like attributes.&lt;/div&gt;&lt;/div&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;align=left;verticalAlign=top;spacing=12;" parent="1" vertex="1">
          <mxGeometry x="1616.5" y="-2270" width="352" height="310" as="geometry" />
        </mxCell>
